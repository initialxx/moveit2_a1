<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="onero_a1">
  <xacro:arg name="gripper_model" default="none"/>
  <xacro:include filename="onero_a1.srdf"/>
  <xacro:if value="${'$(arg gripper_model)' == 'woan_picker'}">
    <xacro:include filename="onero_woan_picker.srdf"/>
  </xacro:if>
</robot>
