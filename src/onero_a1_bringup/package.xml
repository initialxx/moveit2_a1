<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>onero_a1_bringup</name>
  <version>0.1.0</version>
  <description>
    Launch files and ros2_control configuration for the Onero A1 arm.
    Provides the topic bridge that connects joint_state_topic_hardware_interface
    to the Onero SDK (armsdk).
  </description>
  <maintainer email="dev@onerobot.com">Onero Robotics</maintainer>
  <license>Apache-2.0</license>

  <url type="repository">https://github.com/onerobotics/onero_a1_ros2</url>
  <url type="bugtracker">https://github.com/onerobotics/onero_a1_ros2/issues</url>

  <buildtool_depend>ament_python</buildtool_depend>

  <!-- 注意：真机模式（simulate:=false）运行时还需要 onero-sdk（PyPI 包）。
       它目前不是 rosdep key，因此**故意不在此声明** —— 声明了会让
       `rosdep install` 与 ROS build farm 直接失败。
       发布前应先向 rosdistro 提 rosdep key：
           onero_sdk:
             pip:
               packages: [onero-sdk]
       在那之前，真机用户请自行 `pip install onero-sdk`；
       桥接节点在缺少该依赖时会给出明确报错，不会静默降级。 -->

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>controller_manager_msgs</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>joint_trajectory_controller</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>onero_a1_description</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
