<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>onero_a1_description</name>
  <version>0.1.0</version>
  <description>
    URDF description, meshes and ros2_control configuration for the Onero A1 7-DOF robot arm.
    Robot body is generated from the authoritative URDF in onero-sdk (see tools/sync_description_from_sdk.py).
  </description>
  <maintainer email="dev@onerobot.com">Onero Robotics</maintainer>
  <license>Apache-2.0</license>

  <url type="repository">https://github.com/onerobotics/onero_a1_ros2</url>
  <url type="bugtracker">https://github.com/onerobotics/onero_a1_ros2/issues</url>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- launch 文件里 import 的包 -->
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <!-- 描述与可视化 -->
  <exec_depend>urdf</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <!-- ros2_control 硬件插件
       mock_components/GenericSystem 由 hardware_interface 提供 -->
  <exec_depend>hardware_interface</exec_depend>
  <exec_depend>joint_state_topic_hardware_interface</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
